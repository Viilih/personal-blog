---
import { languages } from "../i18n/ui";
import { getRelativeLocaleUrl } from "astro:i18n";

const currentPath = Astro.url.pathname;
const currentLang = Astro.currentLocale ?? "en";
const newLang = currentLang === "en" ? "pt-br" : "en";
const cleanPath = currentPath.replace(/^\/(en|pt-br)/, "");
---

<div class="language-picker">
  {
    Object.entries(languages).map(([lang, label], index) => (
      <>
        {index > 0 && <div class="language-separator" />}
        <a
          href={getRelativeLocaleUrl(newLang, cleanPath)}
          class={`language-link ${currentLang === lang ? "active" : ""}`}
        >
          {lang === "pt-br" ? "PT" : "EN"}
          <span class="sr-only">{label}</span>
        </a>
      </>
    ))
  }
</div>

<style>
  .language-picker {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
  }

  .language-link {
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    padding: 0.2rem 0.35rem;
    transition: color 0.2s ease;
    color: var(--language-inactive);
  }

  .language-link:hover {
    color: var(--language-hover);
    text-decoration: none;
  }

  .language-link.active {
    color: var(--language-active);
    font-weight: 600;
  }

  .language-separator {
    height: 12px;
    width: 1px;
    background-color: var(--language-separator);
    margin: 0 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
