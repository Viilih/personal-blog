---
import type { WorkItem } from "../data/work";
import type { SiteLang } from "../data/site";

interface Props {
  item: WorkItem;
  lang: SiteLang;
  repoLabel: string;
  demoLabel: string;
}

const { item, lang, repoLabel, demoLabel } = Astro.props;
---

<article class="work-card">
  <div class="work-card__media">
    <img
      class="work-card__image"
      src={item.image.src}
      width={item.image.width}
      height={item.image.height}
      alt={item.image.alt[lang]}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="work-card__body">
    <h3 class="work-card__title">{item.title[lang]}</h3>
    <p class="work-card__summary">{item.summary[lang]}</p>
    <p class="work-card__stack mono">{item.stack.join(" · ")}</p>
    <p class="work-card__links">
      <a href={item.repoUrl} target="_blank" rel="noreferrer noopener"
        >{repoLabel}</a
      >
      {
        item.demoUrl && (
          <>
            <span class="work-card__sep" aria-hidden="true">
              /
            </span>
            <a href={item.demoUrl} target="_blank" rel="noreferrer noopener">
              {demoLabel}
            </a>
          </>
        )
      }
    </p>
  </div>
</article>

<style>
  .work-card {
    display: grid;
    gap: 1rem;
    padding: 0 0 1.75rem;
    border-bottom: 1px solid var(--border);
  }

  .work-card:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .work-card__media {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface-color);
  }

  .work-card__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .work-card__title {
    margin: 0 0 0.4rem;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .work-card__summary {
    margin: 0 0 0.55rem;
    color: var(--color);
    max-width: 40rem;
  }

  .work-card__stack {
    margin: 0 0 0.65rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .work-card__links {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    align-items: center;
  }

  .work-card__links a {
    color: var(--heading-color);
    text-decoration: none;
  }

  .work-card__links a:hover {
    color: var(--accent-color);
    text-decoration: underline;
  }

  .work-card__sep {
    color: var(--text-muted);
    opacity: 0.6;
  }

  @media (min-width: 720px) {
    .work-card {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 1.5rem;
      align-items: start;
    }
  }
</style>
