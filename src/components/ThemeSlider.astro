---
const { id } = Astro.props;
---

<div class="toggle-container">
  <span class="light">light</span>
  <div>
    <label class="switch" aria-label="Switch theme">
      <input id={id} class="theme-toggle" type="checkbox" />
      <span class="slider round"></span>
    </label>
  </div>
  <span class="dark">dark</span>
</div>

<style>
  .toggle-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.45em;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .light {
    color: var(--light-theme-indicator-color);
  }

  .dark {
    color: var(--dark-theme-indicator-color);
  }

  .switch {
    position: relative;
    display: inline-block;
    width: 40px;
    height: 22px;
  }

  .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .slider {
    position: absolute;
    cursor: pointer;
    inset: 0;
    background-color: var(--border);
    transition: background-color 0.25s ease;
  }

  .slider:before {
    position: absolute;
    content: "";
    height: 16px;
    width: 16px;
    left: 3px;
    bottom: 3px;
    background-color: var(--surface-color);
    border: 1px solid var(--border);
    transition: transform 0.25s ease;
    transform: translateX(0);
    border-radius: 50%;
  }

  input.theme-toggle:checked + .slider:before {
    transform: translateX(18px);
  }

  input.theme-toggle:focus-visible + .slider {
    outline: 2px solid var(--accent-color);
    outline-offset: 2px;
  }

  input:checked + .slider {
    background-color: var(--accent-color);
  }

  .slider.round {
    border-radius: 999px;
  }

  .slider.round:before {
    border-radius: 50%;
  }
</style>
