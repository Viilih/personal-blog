---
import BlogPost from "./BlogPost.astro";
import { previewText } from "../utils/excerpt";

interface Props {
  posts: Array<{
    id: string;
    body?: string;
    data: {
      title: string;
      pubDate: Date;
      draft: boolean;
      description?: string;
    };
    _type?: "article" | "note" | "weekly";
  }>;
  showType?: boolean;
  /** Hover/focus preview + coarse inline synopsis. Default true. */
  enablePreview?: boolean;
}

const currentLang = Astro.currentLocale || "en";
const { posts, showType = true, enablePreview = true } = Astro.props;

const getPostUrl = (post: (typeof posts)[number], lang: string) => {
  if (post._type === "note") return `/${lang}/notes/${post.id}`;
  if (post._type === "weekly") return `/${lang}/learning/weekly/${post.id}`;
  return `/${lang}/blog/${post.id}`;
};
---

<ul class="post-list">
  {
    posts.map((post) => {
      const preview = enablePreview
        ? previewText(post.data.description, post.body)
        : undefined;

      const previewId = preview
        ? `post-preview-${post._type ?? "post"}-${post.id}`
        : undefined;

      return (
        <BlogPost
          postTitle={post.data.title}
          url={getPostUrl(post, currentLang)}
          pubDate={post.data.pubDate}
          postType={showType ? post._type : undefined}
          preview={preview}
          previewId={previewId}
        />
      );
    })
  }
</ul>

<style>
  .post-list {
    width: 100%;
    display: flex;
    flex-direction: column;
    padding: 0;
    margin: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
</style>
