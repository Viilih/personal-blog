---
import BlogPost from "./BlogPost.astro";

interface Props {
  posts: Array<{
    id: string;
    data: {
      title: string;
      pubDate: Date;
      draft: boolean;
    };
    _type?: "article" | "note" | "weekly";
  }>;
  showType?: boolean;
}

const currentLang = Astro.currentLocale || "en";
const { posts, showType = true } = Astro.props;

const getPostUrl = (post: any, lang: string) => {
  if (post._type === "note") return `/${lang}/notes/${post.id}`;
  if (post._type === "weekly") return `/${lang}/learning/weekly/${post.id}`;
  return `/${lang}/blog/${post.id}`;
};
---

<ul class="post-list">
  {
    posts.map((post) => {
      return (
        <BlogPost
          postTitle={post.data.title}
          url={getPostUrl(post, currentLang)}
          pubDate={post.data.pubDate}
          postType={showType ? post._type : undefined}
        />
      );
    })
  }
</ul>

<style>
  .post-list {
    width: 100%;
    display: flex;
    flex-direction: column;
    padding: 0;
    margin: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
</style>
