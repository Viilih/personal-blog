---
import PostBadge from "./PostBadge.astro";

interface Props {
  postTitle: string;
  url: string | undefined;
  pubDate: Date;
  postType?: "article" | "note" | "weekly";
}

const { postTitle, url, pubDate, postType } = Astro.props;
const currentLocale = (Astro.currentLocale || "en") as "en" | "pt-br";

const formatDate = (date: Date, locale: string) => {
  const utcDate = new Date(date.getTime() + date.getTimezoneOffset() * 60000);
  const month = String(utcDate.getMonth() + 1).padStart(2, "0");
  const day = String(utcDate.getDate()).padStart(2, "0");
  const year = utcDate.getFullYear();

  if (locale === "pt-br") {
    return `${day}/${month}/${year}`;
  }
  return `${year}-${month}-${day}`;
};

const publishDate = new Date(pubDate);
const formattedDate = formatDate(publishDate, currentLocale);
---

<li class="post-row">
  <a href={url} class="post-link">
    <span class="post-main">
      {postType && <PostBadge type={postType} lang={currentLocale} />}
      <span class="post-title">{postTitle}</span>
    </span>
    <time class="post-date" datetime={publishDate.toISOString()}
      >{formattedDate}</time
    >
  </a>
</li>

<style>
  .post-row {
    list-style: none;
    margin: 0;
    border-bottom: 1px solid var(--border);
  }

  .post-row:last-child {
    border-bottom: none;
  }

  .post-link {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0;
    text-decoration: none;
    color: var(--color);
    transition: color var(--transition-speed) ease;
  }

  .post-link:hover {
    text-decoration: none;
    color: var(--link-color);
  }

  .post-link:hover .post-title {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .post-main {
    flex: 1;
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    min-width: 0;
  }

  .post-title {
    flex: 1;
    font-weight: 500;
    color: var(--heading-color);
    line-height: 1.4;
  }

  .post-link:hover .post-title {
    color: var(--link-color);
  }

  .post-date {
    flex-shrink: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .post-link {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
      padding: 1rem 0;
    }
  }
</style>
