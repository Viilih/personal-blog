---
import PostBadge from "./PostBadge.astro";

interface Props {
  postTitle: string;
  url: string | undefined;
  pubDate: Date;
  postType?: "article" | "note" | "weekly";
  /** Description or excerpt — shown in hover/focus preview and inline on coarse pointers. */
  preview?: string;
  previewId?: string;
}

const { postTitle, url, pubDate, postType, preview, previewId } = Astro.props;
const currentLocale = (Astro.currentLocale || "en") as "en" | "pt-br";

const formatDate = (date: Date, locale: string) => {
  const utcDate = new Date(date.getTime() + date.getTimezoneOffset() * 60000);
  const month = String(utcDate.getMonth() + 1).padStart(2, "0");
  const day = String(utcDate.getDate()).padStart(2, "0");
  const year = utcDate.getFullYear();

  if (locale === "pt-br") {
    return `${day}/${month}/${year}`;
  }
  return `${year}-${month}-${day}`;
};

const publishDate = new Date(pubDate);
const formattedDate = formatDate(publishDate, currentLocale);
const describedBy = preview && previewId ? previewId : undefined;
---

<li class="post-row">
  <a href={url} class="post-link" aria-describedby={describedBy}>
    <span class="post-link__row">
      <span class="post-main">
        {postType && <PostBadge type={postType} lang={currentLocale} />}
        <span class="post-title">{postTitle}</span>
      </span>
      <time class="post-date" datetime={publishDate.toISOString()}
        >{formattedDate}</time
      >
    </span>

    {
      preview && (
        <>
          <span class="post-description" id={previewId}>
            {preview}
          </span>
          <span class="post-preview" aria-hidden="true">
            <span class="post-preview__title">{postTitle}</span>
            <time
              class="post-preview__date mono"
              datetime={publishDate.toISOString()}
            >
              {formattedDate}
            </time>
            <span class="post-preview__body">{preview}</span>
          </span>
        </>
      )
    }
  </a>
</li>

<style>
  .post-row {
    list-style: none;
    margin: 0;
    border-bottom: 1px solid var(--border);
  }

  .post-row:last-child {
    border-bottom: none;
  }

  .post-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 100%;
    padding: 0.85rem 0;
    text-decoration: none;
    color: var(--color);
    transition: color var(--transition-speed) ease;
  }

  .post-link:hover {
    text-decoration: none;
    color: var(--link-color);
  }

  .post-link:focus {
    outline: none;
  }

  .post-link:focus-visible {
    outline: 1px solid var(--accent-color);
    outline-offset: 3px;
  }

  .post-link__row {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .post-link:hover .post-title {
    text-decoration: underline;
    text-underline-offset: 0.15em;
    color: var(--link-color);
  }

  .post-main {
    flex: 1;
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    min-width: 0;
  }

  .post-title {
    flex: 1;
    font-weight: 500;
    color: var(--heading-color);
    line-height: 1.4;
  }

  .post-date {
    flex-shrink: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  /* Default / coarse: synopsis stays in the list. */
  .post-description {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--text-muted);
    max-width: 42rem;
  }

  .post-preview {
    display: none;
    width: 100%;
    max-width: 42rem;
    margin: 0.15rem 0 0;
    padding: 0.55rem 0 0.15rem 0.75rem;
    border-left: 2px solid var(--prompt-color);
    background: transparent;
  }

  .post-preview__title {
    display: block;
    font-weight: 500;
    color: var(--heading-color);
    line-height: 1.35;
    margin-bottom: 0.2rem;
  }

  .post-preview__date {
    display: block;
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .post-preview__body {
    display: block;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--text-muted);
  }

  @media (hover: hover) and (pointer: fine) {
    /* Keep text for aria-describedby; hide visually in favor of hover panel. */
    .post-description {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .post-link:hover .post-preview,
    .post-link:focus-visible .post-preview {
      display: block;
    }
  }

  @media (hover: none), (pointer: coarse) {
    .post-preview {
      display: none !important;
    }
  }

  @media (max-width: 640px) {
    .post-link {
      padding: 1rem 0;
    }

    .post-link__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
  }
</style>
