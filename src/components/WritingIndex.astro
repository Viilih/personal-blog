---
import { getCollection } from "astro:content";
import GoBackButton from "./GoBackButton.astro";
import PostList from "./PostList.astro";
import { useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  lang: "en" | "pt-br";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const blogPosts =
  lang === "en"
    ? await getCollection("en", (post) => !post.data.draft)
    : await getCollection("pt-br", (post) => !post.data.draft);
const notePosts =
  lang === "en"
    ? await getCollection("en-notes", (post) => !post.data.draft)
    : await getCollection("pt-br-notes", (post) => !post.data.draft);

const posts = [
  ...blogPosts.map((post) => ({ ...post, _type: "article" as const })),
  ...notePosts.map((post) => ({ ...post, _type: "note" as const })),
].sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime();
  const dateB = new Date(b.data.pubDate).getTime();
  return dateB - dateA;
});
---

<BaseLayout
  title={t("seo.writing.title")}
  description={t("seo.writing.description")}
>
  <section class="index-page">
    <GoBackButton />
    <header class="index-page__header">
      <p class="index-page__path" aria-hidden="true">~/writing</p>
      <h1 class="page-title">{t("seo.writing.title")}</h1>
    </header>
    {
      posts.length === 0 ? (
        <p class="index-page__empty">{t("writing.empty")}</p>
      ) : (
        <PostList posts={posts} showType={false} />
      )
    }
  </section>
</BaseLayout>

<style>
  .index-page__header {
    margin: 0.75rem 0 1.5rem;
  }

  .index-page__path {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--prompt-color);
  }

  .index-page__empty {
    color: var(--text-muted);
  }
</style>
