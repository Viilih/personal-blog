---
import { useTranslations } from "../i18n/utils";

interface Props {
  type: "article" | "note" | "weekly";
  lang: "en" | "pt-br";
}

const { type, lang } = Astro.props;
const t = useTranslations(lang);
---

<span class={`post-badge post-badge-${type}`}>
  {t(`post.type.${type}`)}
</span>

<style>
  .post-badge {
    display: inline-block;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    text-transform: lowercase;
    letter-spacing: 0.02em;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-muted);
  }

  .post-badge-article {
    color: var(--link-color);
    border-color: color-mix(in srgb, var(--link-color) 35%, var(--border));
  }

  .post-badge-note {
    color: var(--accent-color);
    border-color: color-mix(in srgb, var(--accent-color) 40%, var(--border));
  }

  .post-badge-weekly {
    color: var(--text-muted);
  }
</style>
