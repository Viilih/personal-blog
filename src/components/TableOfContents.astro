---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Heading {
  depth: number;
  text: string;
  slug: string;
  subheadings: Heading[];
}

interface Props {
  toc: Heading[];
  /** Unique suffix when multiple TOCs are rendered (rail + inline). */
  idSuffix?: string;
  /** Emit the shared TOC script once (use on a single instance). */
  includeScript?: boolean;
}

const { toc = [], idSuffix = "main", includeScript = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const validToc = toc.filter(
  (heading) => heading && heading.slug && heading.text,
);

const toggleId = `toc-toggle-${idSuffix}`;
const contentId = `toc-content-${idSuffix}`;
---

{
  validToc.length > 0 && (
    <nav class="toc" data-toc={idSuffix} aria-label={t("toc.contents")}>
      <button
        class="toc-header"
        type="button"
        id={toggleId}
        aria-expanded={idSuffix === "rail" ? "true" : "false"}
        aria-controls={contentId}
      >
        <span class="toc-title">{t("toc.contents")}</span>
        <span class="toc-count">{validToc.length}</span>
        <svg
          class:list={["toc-icon", { rotated: idSuffix === "rail" }]}
          aria-hidden="true"
          viewBox="0 0 330 330"
          fill="currentColor"
        >
          <path d="M325.607 79.393a15 15 0 0 0-21.213.001L165.004 218.787 25.607 79.393a15 15 0 0 0-21.213 21.214l150.004 150a15 15 0 0 0 21.212-.001l149.996-150a15 15 0 0 0 .001-21.213Z" />
        </svg>
      </button>
      <ul class:list={["toc-list", { show: idSuffix === "rail" }]} id={contentId}>
        {validToc.map((heading) => (
          <li>
            <a href={`#${heading.slug}`} class="toc-link">
              {heading.text}
            </a>
            {heading.subheadings && heading.subheadings.length > 0 && (
              <ul class="toc-sublist">
                {heading.subheadings.map((subheading) => (
                  <li>
                    <a href={`#${subheading.slug}`} class="toc-sublink">
                      {subheading.text}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    background: transparent;
    padding: 0;
    width: 100%;
    border: none;
    box-shadow: none;
  }

  .toc-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
    padding: 0 0 0.55rem;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: transparent;
    cursor: pointer;
    text-align: left;
    color: inherit;
    font-family: var(--font-mono);
  }

  .toc-header:focus-visible {
    outline: 1px solid var(--accent-color);
    outline-offset: 3px;
  }

  .toc-title {
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: lowercase;
    color: var(--toc-text-secondary);
  }

  .toc-count {
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    color: var(--toc-text-secondary);
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    line-height: 1.3;
  }

  .toc-icon {
    margin-left: auto;
    color: var(--toc-text-secondary);
    transition: transform var(--transition-speed) ease;
    width: 0.65em;
    height: 0.65em;
    flex-shrink: 0;
  }

  .toc-icon.rotated {
    transform: rotate(180deg);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-height var(--transition-speed) cubic-bezier(0.4, 0, 0.2, 1),
      opacity calc(var(--transition-speed) * 0.8) ease,
      margin-top var(--transition-speed) cubic-bezier(0.4, 0, 0.2, 1);
  }

  .toc-list.show {
    max-height: min(60vh, 28rem);
    opacity: 1;
    margin-top: 0.65rem;
    overflow-y: auto;
    padding-right: 0.2rem;
    scrollbar-width: thin;
  }

  .toc-link,
  .toc-sublink {
    display: block;
    text-decoration: none;
    line-height: 1.4;
    transition: color var(--transition-speed) ease;
    padding: 0.3rem 0 0.3rem 0.7rem;
    border-left: 2px solid var(--border);
  }

  .toc-link {
    color: var(--toc-text-primary);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .toc-sublink {
    color: var(--toc-text-secondary);
    font-size: 0.78rem;
    padding-left: 1.15rem;
    font-weight: 400;
  }

  .toc-link:hover,
  .toc-sublink:hover {
    color: var(--link-color);
    text-decoration: none;
  }

  .toc-link.current,
  .toc-sublink.current {
    color: var(--accent-color);
    border-left-color: var(--accent-color);
  }

  .toc-sublist {
    list-style: none;
    padding-left: 0;
    margin: 0.1rem 0 0.3rem;
  }

  @media (max-width: 1024px) {
    .toc {
      position: relative;
      top: auto;
      padding: 0.75rem 0.85rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--surface-color);
    }

    .toc-header {
      padding-bottom: 0;
      border-bottom: 0;
    }

    .toc-list.show {
      max-height: 240px;
      margin-top: 0.55rem;
      padding-top: 0.45rem;
      border-top: 1px solid var(--border);
    }
  }
</style>

{includeScript && (
<script is:inline>
  function throttle(func, limit) {
    let lastFunc;
    let lastRan;
    return function (...args) {
      const context = this;
      if (!lastRan) {
        func.apply(context, args);
        lastRan = Date.now();
      } else {
        clearTimeout(lastFunc);
        lastFunc = setTimeout(
          function () {
            if (Date.now() - lastRan >= limit) {
              func.apply(context, args);
              lastRan = Date.now();
            }
          },
          limit - (Date.now() - lastRan),
        );
      }
    };
  }

  function initializeOneTOC(tocContainer) {
    if (tocContainer.dataset.tocReady === "1") return;
    tocContainer.dataset.tocReady = "1";

    const tocToggle = tocContainer.querySelector(".toc-header");
    const tocContent = tocContainer.querySelector(".toc-list");
    const tocIcon = tocContainer.querySelector(".toc-icon");
    const tocLinks = Array.from(
      tocContainer.querySelectorAll(".toc-link, .toc-sublink"),
    );

    if (!tocToggle || !tocContent || !tocIcon || tocLinks.length === 0) {
      tocContainer.style.display = "none";
      return;
    }

    const toggle = (isOpen) => {
      const shouldBeOpen =
        typeof isOpen === "boolean"
          ? isOpen
          : tocToggle.getAttribute("aria-expanded") === "false";
      tocToggle.setAttribute("aria-expanded", String(shouldBeOpen));
      tocContent.classList.toggle("show", shouldBeOpen);
      tocIcon.classList.toggle("rotated", shouldBeOpen);
    };

    const prefersRail = window.matchMedia("(min-width: 1025px)").matches;
    const isRail = tocContainer.dataset.toc === "rail";
    toggle(prefersRail && isRail);

    tocToggle.addEventListener("click", () => toggle());

    const articleHeadings = Array.from(
      document.querySelectorAll(
        "main h2[id], main h3[id], main h4[id], main h5[id], main h6[id]",
      ),
    ).sort((a, b) => a.offsetTop - b.offsetTop);
    if (articleHeadings.length === 0) return;

    const handleScroll = () => {
      let currentHeadingId = null;
      const scrollPosition = window.scrollY + 72;

      for (let i = articleHeadings.length - 1; i >= 0; i--) {
        if (articleHeadings[i].offsetTop <= scrollPosition) {
          currentHeadingId = articleHeadings[i].id;
          break;
        }
      }

      tocLinks.forEach((link) => {
        const linkHref = link.getAttribute("href");
        const linkHash = linkHref.startsWith("#")
          ? linkHref
          : new URL(linkHref, window.location.href).hash;

        if (linkHash === `#${currentHeadingId}`) {
          link.classList.add("current");
        } else {
          link.classList.remove("current");
        }
      });
    };

    const throttledScrollHandler = throttle(handleScroll, 100);

    window.addEventListener("scroll", throttledScrollHandler, {
      passive: true,
    });
    handleScroll();

    tocLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        const targetId = link.getAttribute("href").substring(1);
        const targetElement = document.getElementById(targetId);

        if (targetElement) {
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.scrollY - 12;

          window.scrollTo({
            top: offsetPosition,
            behavior: "smooth",
          });

          history.pushState(null, null, `#${targetId}`);
          setTimeout(() => handleScroll(), 50);

          if (!window.matchMedia("(min-width: 1025px)").matches) {
            toggle(false);
          }
        }
      });
    });
  }

  function initializeTOC() {
    document.querySelectorAll(".toc").forEach((tocContainer) => {
      tocContainer.dataset.tocReady = "";
      initializeOneTOC(tocContainer);
    });
  }

  initializeTOC();
  document.addEventListener("astro:after-swap", initializeTOC);
</script>
)}
