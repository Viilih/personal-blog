---
import LanguagePicker from "../components/LanguagePicker.astro";
import ThemeSlider from "./ThemeSlider.astro";
import VaultSearch from "./VaultSearch.astro";
import VaultTree from "./VaultTree.astro";
---

<div class="sidebar-container">
  <div class="language-switcher">
    <LanguagePicker />
    <ThemeSlider id="theme-toggle" />
  </div>

  <p class="vault-label">Vault</p>
  <VaultSearch />
  <VaultTree />
</div>

<style>
  .sidebar-container {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: 14rem;
  }

  .language-switcher {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 0.25rem;
  }

  .vault-label {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--language-inactive);
    text-align: right;
  }

  @media (max-width: 768px) {
    .sidebar-container {
      width: 100%;
    }

    .vault-label {
      text-align: left;
      margin-left: 0.6rem;
    }
  }
</style>
