---
import GoBackButton from "components/GoBackButton.astro";
import Link from "components/Link.astro";
import BaseLayout from "layouts/BaseLayout.astro";
---

<BaseLayout title="Now · Guilherme">
  <GoBackButton />
  <header class="now-header">
    <p class="now-path" aria-hidden="true">~/now</p>
    <h1 class="page-title">What I'm doing now</h1>
    <p class="now-updated mono">
      {new Date().toLocaleDateString("en-US", { dateStyle: "medium" })}
    </p>
  </header>

  <section class="now-section">
    <h2>Work</h2>
    <p>
      Software developer at
      <Link href="https://stefanini.com/pt-br">Stefanini</Link>, working with:
    </p>
    <ul>
      <li>NodeJS / NestJS</li>
      <li>React / TypeScript</li>
      <li>Java / Spring Boot</li>
      <li>Azure DevOps · Postgres</li>
    </ul>
  </section>

  <section class="now-section">
    <h2>Learning</h2>
    <ul>
      <li>DevOps (Kubernetes and Docker)</li>
      <li>Computer Science fundamentals</li>
      <li>TypeScript</li>
      <li>Data Structures and Algorithms</li>
      <li>System design</li>
      <li>Java / Spring Boot</li>
    </ul>
  </section>

  <section class="now-section">
    <h2>Building</h2>
    <p>This site, continuously.</p>
  </section>

  <section class="now-section">
    <h2>Hobbies</h2>
    <p>Guitar · Brazilian Jiu-Jitsu (BJJ)</p>
  </section>
</BaseLayout>

<style>
  .now-header {
    margin: 0.75rem 0 2rem;
  }

  .now-path {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--prompt-color);
  }

  .now-updated {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .now-section {
    margin-bottom: 1.75rem;
    max-width: 40rem;
  }

  .now-section h2 {
    margin: 0 0 0.65rem;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .now-section ul {
    margin: 0.5rem 0 0;
  }
</style>
