---
import GoBackButton from "components/GoBackButton.astro";
import Link from "components/Link.astro";
import BaseLayout from "layouts/BaseLayout.astro";

const lastUpdated = "November 8, 2026";
---

<BaseLayout title="Now · Guilherme">
  <GoBackButton />
  <header class="now-header">
    <p class="now-path" aria-hidden="true">~/now</p>
    <h1 class="page-title">What I'm doing now</h1>
    <p class="now-updated mono">Last updated · {lastUpdated}</p>
  </header>

  <section class="now-section">
    <h2>Work</h2>
    <p>
      Fullstack developer at
      <Link href="https://stefanini.com/pt-br">Stefanini</Link>. Day-to-day is
      mostly <strong>Spring Boot</strong> and <strong>Postgres</strong>, with
      the rest of the stack around it:
    </p>
    <ul class="now-groups">
      <li>
        <span class="now-group-label">Backend</span>
        Spring Boot · Postgres · Node.js / NestJS
      </li>
      <li>
        <span class="now-group-label">Frontend</span>
        React · TypeScript
      </li>
      <li>
        <span class="now-group-label">Tooling</span>
        Azure DevOps
      </li>
    </ul>
  </section>

  <section class="now-section">
    <h2>Studies</h2>
    <ul class="now-groups">
      <li>
        <span class="now-group-label">Ledger Pay / systems</span>
        Databases · locks · idempotency
      </li>
      <li>
        <span class="now-group-label">Algorithms</span>
        Data structures &amp; algorithms
      </li>
    </ul>
  </section>

  <section class="now-section">
    <h2>Building</h2>
    <ul>
      <li>This digital garden / blog</li>
      <li>Ledger Pay — a personal payments project</li>
    </ul>
  </section>

  <section class="now-section">
    <h2>Hobbies</h2>
    <ul>
      <li>Guitar (electric and acoustic)</li>
      <li>Brazilian Jiu-Jitsu — blue belt</li>
      <li>Surfing</li>
    </ul>
  </section>

  <section class="now-section">
    <h2>Reading</h2>
    <ul>
      <li><em>Grokking Algorithms</em>, 2nd edition</li>
      <li><em>O Adversário Secreto</em> (Agatha Christie)</li>
    </ul>
  </section>
</BaseLayout>

<style>
  .now-header {
    margin: 0.75rem 0 2rem;
  }

  .now-path {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--prompt-color);
  }

  .now-updated {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .now-section {
    margin-bottom: 1.75rem;
    max-width: 40rem;
  }

  .now-section h2 {
    margin: 0 0 0.65rem;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .now-section p {
    margin: 0 0 0.75rem;
  }

  .now-section ul {
    margin: 0.35rem 0 0;
    padding-left: 1.15rem;
  }

  .now-section li {
    margin-bottom: 0.4rem;
  }

  .now-groups {
    list-style: none;
    padding-left: 0;
  }

  .now-groups li {
    display: grid;
    gap: 0.15rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--border);
  }

  .now-groups li:last-child {
    border-bottom: none;
  }

  .now-group-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-color);
  }
</style>
