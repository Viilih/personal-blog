---
import { getCollection } from "astro:content";
import PostList from "../../components/PostList.astro";
import WorkCard from "../../components/WorkCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";
import { workItems } from "../../data/work";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations("en");
const lang = "en" as const;

const blogPosts = await getCollection("en", (post) => !post.data.draft);
const notePosts = await getCollection("en-notes", (post) => !post.data.draft);
const weeklyPosts = await getCollection("en-weekly", (post) => !post.data.draft);

const allPosts = [
  ...blogPosts.map((post) => ({ ...post, _type: "article" as const })),
  ...notePosts.map((post) => ({ ...post, _type: "note" as const })),
  ...weeklyPosts.map((post) => ({ ...post, _type: "weekly" as const })),
];

const sortedPosts = allPosts
  .sort((a, b) => {
    const dateA = new Date(a.data.pubDate).getTime();
    const dateB = new Date(b.data.pubDate).getTime();
    return dateB - dateA;
  })
  .slice(0, 6);

const typeOrder = ["article", "note", "weekly"] as const;
const typeLabels = {
  article: "articles",
  note: "notes",
  weekly: "weekly",
} as const;

const writingByType = typeOrder
  .map((type) => ({
    type,
    label: typeLabels[type],
    posts: sortedPosts.filter((post) => post._type === type),
  }))
  .filter((group) => group.posts.length > 0);

const roleLine = `${site.role[lang]} · ${site.city[lang]}`;
---

<BaseLayout
  title={t("seo.siteName")}
  description={t("seo.home.description")}
>
  <section class="home">
    <header class="home__hero">
      <p class="home__prompt" aria-hidden="true">
        <span class="home__prompt-symbol">$</span> whoami
      </p>
      <h1 class="home__name">{site.name}</h1>
      <p class="home__tagline">{roleLine}</p>
      <p class="home__actions">
        <a class="home__btn home__btn--primary" href="#work">{t("home.viewWork")}</a>
        <a class="home__btn" href="#contact">{t("home.contactCta")}</a>
      </p>
    </header>

    <section id="work" class="content-section home__work">
      <h2>{t("home.workHeading")}</h2>
      <div class="home__work-list">
        {
          workItems.map((item) => (
            <WorkCard
              item={item}
              lang={lang}
              repoLabel={t("home.repo")}
              demoLabel={t("home.demo")}
            />
          ))
        }
      </div>
    </section>

    <section id="writing" class="content-section home__writing">
      <h2>{t("home.writingHeading")}</h2>
      {
        writingByType.map((group) => (
          <div class="home__group">
            <h3 class="home__group-label">{group.label}</h3>
            <PostList posts={group.posts} showType={false} />
          </div>
        ))
      }
    </section>

    <footer id="contact" class="content-section home__contact">
      <h2>{t("home.contactHeading")}</h2>
      <ul class="home__contact-list">
        <li>
          <span class="home__contact-label mono">{t("home.email")}</span>
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </li>
        <li>
          <span class="home__contact-label mono">{t("home.linkedin")}</span>
          <a
            href={site.contact.linkedin}
            target="_blank"
            rel="noreferrer noopener">LinkedIn</a
          >
        </li>
        <li>
          <span class="home__contact-label mono">{t("home.github")}</span>
          <a
            href={site.contact.github}
            target="_blank"
            rel="noreferrer noopener">GitHub</a
          >
        </li>
      </ul>
    </footer>
  </section>
</BaseLayout>

<style>
  .home__hero {
    max-width: 38rem;
    margin-bottom: 2.5rem;
  }

  .home__prompt {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .home__prompt-symbol {
    color: var(--prompt-color);
    font-weight: 500;
  }

  .home__name {
    margin: 0 0 0.5rem;
    font-size: clamp(2rem, 4vw, 2.5rem);
    letter-spacing: -0.03em;
  }

  .home__tagline {
    margin: 0 0 1.35rem;
    font-size: 1.05rem;
    color: var(--text-muted);
  }

  .home__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 0;
  }

  .home__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--heading-color);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    background: transparent;
    transition:
      color var(--transition-speed) ease,
      background-color var(--transition-speed) ease,
      border-color var(--transition-speed) ease;
  }

  .home__btn:hover {
    text-decoration: none;
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  .home__btn--primary {
    background: var(--accent-soft);
    border-color: transparent;
    color: var(--heading-color);
  }

  .home__btn--primary:hover {
    background: var(--accent-soft);
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  .home__work,
  .home__writing,
  .home__contact {
    margin-top: 2.5rem;
    scroll-margin-top: 1.5rem;
  }

  .home__work-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-top: 1rem;
  }

  .home__writing :global(.post-list) {
    border-top: none;
  }

  .home__group {
    margin-bottom: 1.25rem;
  }

  .home__group:last-child {
    margin-bottom: 0;
  }

  .home__group-label {
    margin: 0 0 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    color: var(--prompt-color);
  }

  .home__contact-list {
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .home__contact-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    align-items: baseline;
  }

  .home__contact-label {
    min-width: 5.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .home__contact-list a {
    color: var(--heading-color);
    text-decoration: none;
  }

  .home__contact-list a:hover {
    color: var(--accent-color);
    text-decoration: underline;
  }
</style>
