---
import { getCollection } from "astro:content";
import PostList from "../../components/PostList.astro";
import { nowMeta } from "../../data/now";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Link from "components/Link.astro";

const now = nowMeta["pt-br"];
const blogPosts = await getCollection("pt-br", (post) => !post.data.draft);
const notePosts = await getCollection("pt-br-notes", (post) => !post.data.draft);
const weeklyPosts = await getCollection("pt-br-weekly", (post) => !post.data.draft);

const allPosts = [
  ...blogPosts.map((post) => ({ ...post, _type: "article" as const })),
  ...notePosts.map((post) => ({ ...post, _type: "note" as const })),
  ...weeklyPosts.map((post) => ({ ...post, _type: "weekly" as const })),
];

const sortedPosts = allPosts
  .sort((a, b) => {
    const dateA = new Date(a.data.pubDate).getTime();
    const dateB = new Date(b.data.pubDate).getTime();
    return dateB - dateA;
  })
  .slice(0, 6);

const typeOrder = ["article", "note", "weekly"] as const;
const typeLabels = {
  article: "artigos",
  note: "anotações",
  weekly: "semanal",
} as const;

const recentByType = typeOrder
  .map((type) => ({
    type,
    label: typeLabels[type],
    posts: sortedPosts.filter((post) => post._type === type),
  }))
  .filter((group) => group.posts.length > 0);
---

<BaseLayout title="Guilherme Nascimento">
  <section class="home">
    <header class="home__hero">
      <p class="home__prompt" aria-hidden="true">
        <span class="home__prompt-symbol">$</span> whoami
      </p>
      <h1 class="home__name">Guilherme Nascimento</h1>
      <p class="home__tagline">Engenheiro de software · fullstack</p>
      <p class="home__lead">
        Trabalho com React, TypeScript, Java, Spring Boot e Postgres. Estudo
        fundamentos de ciência da computação, estruturas de dados e algoritmos.
        Veja o que estou fazendo agora em <a href="/pt-br/now">/now</a>.
      </p>
      <p class="home__hobbies">
        Fora do trabalho: mágica, astronomia, música e livros.
      </p>
      <p class="home__links">
        Código e projetos no
        <Link href="https://github.com/Viilih">GitHub</Link>.
      </p>
    </header>

    <nav class="home__explore" aria-label="Explorar">
      <span class="home__explore-label" aria-hidden="true">~/</span>
      <a href="/pt-br/articles">articles</a>
      <span class="home__sep" aria-hidden="true">/</span>
      <a href="/pt-br/notes">notes</a>
      <span class="home__sep" aria-hidden="true">/</span>
      <a
        class="home__now-link"
        href="/pt-br/now"
        aria-describedby="home-now-preview"
      >
        now
      </a>
    </nav>
    <span class="home__now-preview-sr" id="home-now-preview">
      {now.updatedPrefix} · {now.lastUpdatedDisplay}. {now.blurb}
    </span>
    <div class="home__now-preview" aria-hidden="true">
      <time class="mono" datetime={now.lastUpdatedIso}>
        {now.updatedPrefix} · {now.lastUpdatedDisplay}
      </time>
      <span class="home__now-preview-body">{now.blurb}</span>
    </div>

    <section class="content-section home__recent">
      <h2>Recentes</h2>
      {
        recentByType.map((group) => (
          <div class="home__group">
            <h3 class="home__group-label">{group.label}</h3>
            <PostList posts={group.posts} showType={false} />
          </div>
        ))
      }
    </section>
  </section>
</BaseLayout>

<style>
  .home__hero {
    max-width: 38rem;
    margin-bottom: 2rem;
  }

  .home__prompt {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .home__prompt-symbol {
    color: var(--prompt-color);
    font-weight: 500;
  }

  .home__name {
    margin: 0 0 0.5rem;
    font-size: clamp(2rem, 4vw, 2.5rem);
    letter-spacing: -0.03em;
  }

  .home__tagline {
    margin: 0 0 1.25rem;
    font-size: 1.05rem;
    color: var(--text-muted);
  }

  .home__lead,
  .home__hobbies,
  .home__links {
    margin: 0 0 0.85rem;
    color: var(--color);
  }

  .home__hobbies {
    color: var(--text-muted);
  }

  .home__links {
    margin-bottom: 0;
    color: var(--text-muted);
  }

  .home__explore {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    padding: 0.85rem 0;
    margin-bottom: 0.5rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .home__explore-label {
    color: var(--prompt-color);
    font-weight: 500;
  }

  .home__explore a {
    color: var(--heading-color);
    text-decoration: none;
  }

  .home__explore a:hover {
    color: var(--accent-color);
    text-decoration: underline;
  }

  .home__explore a:focus {
    outline: none;
  }

  .home__explore a:focus-visible {
    outline: 1px solid var(--accent-color);
    outline-offset: 2px;
  }

  .home__sep {
    color: var(--text-muted);
    opacity: 0.6;
  }

  .home__now-preview-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .home__now-preview {
    display: none;
    max-width: 42rem;
    margin: -0.25rem 0 1rem;
    padding: 0.55rem 0 0.2rem 0.75rem;
    border-left: 2px solid var(--prompt-color);
  }

  .home__now-preview time {
    display: block;
    margin: 0 0 0.3rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .home__now-preview-body {
    display: block;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--text-muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .home:has(.home__now-link:hover) .home__now-preview,
    .home:has(.home__now-link:focus-visible) .home__now-preview {
      display: block;
    }
  }

  .home__recent :global(.post-list) {
    border-top: none;
  }

  .home__group {
    margin-bottom: 1.25rem;
  }

  .home__group:last-child {
    margin-bottom: 0;
  }

  .home__group-label {
    margin: 0 0 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    color: var(--prompt-color);
  }
</style>
