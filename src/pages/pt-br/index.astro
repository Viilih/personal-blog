---
import { getCollection } from "astro:content";
import CurrentlyBuilding from "../../components/CurrentlyBuilding.astro";
import PostList from "../../components/PostList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../config/site";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations("pt-br");
const lang = "pt-br" as const;

const blogPosts = await getCollection("pt-br", (post) => !post.data.draft);
const notePosts = await getCollection("pt-br-notes", (post) => !post.data.draft);

const recentWriting = [
  ...blogPosts.map((post) => ({ ...post, _type: "article" as const })),
  ...notePosts.map((post) => ({ ...post, _type: "note" as const })),
]
  .sort((a, b) => {
    const dateA = new Date(a.data.pubDate).getTime();
    const dateB = new Date(b.data.pubDate).getTime();
    return dateB - dateA;
  })
  .slice(0, 3);

const roleLine = `${site.role[lang]} · ${site.city[lang]}`;
---

<BaseLayout
  title={t("seo.siteName")}
  description={t("seo.home.description")}
>
  <section class="home">
    <header class="home__hero">
      <p class="home__prompt" aria-hidden="true">
        <span class="home__prompt-symbol">$</span> whoami
      </p>
      <h1 class="home__name">{site.name}</h1>
      <p class="home__tagline">{roleLine}</p>
      <p class="home__about">{site.about[lang]}</p>
      <p class="home__actions">
        <a
          class="home__btn home__btn--primary"
          href={`mailto:${site.contact.email}`}
          >{t("home.contactCta")}</a
        >
      </p>
    </header>

    <CurrentlyBuilding
      lang={lang}
      label={t("home.buildingLabel")}
      linkLabel={t("home.buildingLink")}
    />

    <section id="writing" class="content-section home__writing">
      <h2>{t("home.writingHeading")}</h2>
      <PostList posts={recentWriting} showType={false} />
      <p class="home__all-writing">
        <a href={`/${lang}/writing`}>{t("home.allWriting")}</a>
      </p>
    </section>
  </section>
</BaseLayout>

<style>
  .home__hero {
    max-width: 38rem;
    margin-bottom: 2rem;
  }

  .home__prompt {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .home__prompt-symbol {
    color: var(--prompt-color);
    font-weight: 500;
  }

  .home__name {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .home__tagline {
    margin: 0 0 0.85rem;
    font-size: 1.05rem;
    color: var(--text-muted);
  }

  .home__about {
    max-width: 60ch;
    margin: 0 0 1.35rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color);
  }

  .home__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 0;
  }

  .home__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--heading-color);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    background: transparent;
    transition:
      color var(--transition-speed) ease,
      background-color var(--transition-speed) ease,
      border-color var(--transition-speed) ease;
  }

  .home__btn:hover {
    text-decoration: none;
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  .home__btn--primary {
    background: var(--accent-soft);
    border-color: transparent;
    color: var(--heading-color);
  }

  .home__btn--primary:hover {
    background: var(--accent-soft);
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  .home__writing {
    margin-top: 2.5rem;
    scroll-margin-top: 1.5rem;
  }

  .home__writing :global(.post-list) {
    border-top: none;
  }

  .home__all-writing {
    margin: 0.85rem 0 0;
  }

  .home__all-writing a {
    font-size: 0.9375rem;
    font-weight: 500;
  }
</style>
