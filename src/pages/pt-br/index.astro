---
import { getCollection } from "astro:content";
import BuildLog from "../../components/BuildLog.astro";
import PostList from "../../components/PostList.astro";
import Projects from "../../components/Projects.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Link from "components/Link.astro";

const blogPosts = await getCollection("pt-br", (post) => !post.data.draft);
const notePosts = await getCollection(
  "pt-br-notes",
  (post) => !post.data.draft,
);
const weeklyPosts = await getCollection(
  "pt-br-weekly",
  (post) => !post.data.draft,
);

const allPosts = [
  ...blogPosts.map((post) => ({ ...post, _type: "article" as const })),
  ...notePosts.map((post) => ({ ...post, _type: "note" as const })),
  ...weeklyPosts.map((post) => ({ ...post, _type: "weekly" as const })),
];

const sortedPosts = allPosts
  .sort((a, b) => {
    const dateA = new Date(a.data.pubDate).getTime();
    const dateB = new Date(b.data.pubDate).getTime();
    return dateB - dateA;
  })
  .slice(0, 5);
---

<BaseLayout title="Guilherme Nascimento">
  <section class="home">
    <header class="home__hero">
      <p class="home__prompt" aria-hidden="true">
        <span class="home__prompt-symbol">$</span> whoami
      </p>
      <h1 class="home__name">Guilherme Nascimento</h1>
      <p class="home__tagline">Engenheiro de software · backend</p>
      <p class="home__lead">
        Foco em backend — Java, Spring Boot, PostgreSQL, pagamentos e ledgers —
        com base fullstack em React, TypeScript, .NET e NestJS, e interesse em
        AI engineering (agentes, LLMs, RAG, MCP). Este mês:
        <a href="/pt-br/now">/now</a>.
      </p>
      <p class="home__links">
        Código e projetos no
        <Link href="https://github.com/Viilih">GitHub</Link>.
      </p>
    </header>

    <nav class="home__explore" aria-label="Explorar">
      <a href="/pt-br/articles">articles</a>
      <span class="home__sep" aria-hidden="true">/</span>
      <a href="/pt-br/notes">notes</a>
      <span class="home__sep" aria-hidden="true">/</span>
      <a href="/pt-br/learning/weekly">weekly</a>
      <span class="home__sep" aria-hidden="true">/</span>
      <a href="/pt-br/learning">learning</a>
    </nav>

    <Projects />
    <BuildLog />

    <section class="content-section">
      <h2>Recentes</h2>
      <PostList posts={sortedPosts} />
    </section>
  </section>
</BaseLayout>

<style>
  .home__hero {
    max-width: 38rem;
    margin-bottom: 2rem;
  }

  .home__prompt {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .home__prompt-symbol {
    color: var(--prompt-color);
    font-weight: 500;
  }

  .home__name {
    margin: 0 0 0.5rem;
    font-size: clamp(2rem, 4vw, 2.5rem);
    letter-spacing: -0.03em;
  }

  .home__tagline {
    margin: 0 0 1.25rem;
    font-size: 1.05rem;
    color: var(--text-muted);
  }

  .home__lead,
  .home__links {
    margin: 0 0 0.85rem;
    color: var(--color);
  }

  .home__links {
    margin-bottom: 0;
    color: var(--text-muted);
  }

  .home__explore {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    padding: 0.85rem 0;
    margin-bottom: 0.5rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .home__explore a {
    color: var(--heading-color);
    text-decoration: none;
  }

  .home__explore a:hover {
    color: var(--accent-color);
    text-decoration: underline;
  }

  .home__sep {
    color: var(--text-muted);
    opacity: 0.6;
  }
</style>
