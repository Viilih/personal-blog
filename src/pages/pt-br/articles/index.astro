---
import { getCollection } from "astro:content";
import PostList from "../../../components/PostList.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const posts = await getCollection("pt-br", (post) => !post.data.draft);

const sortedPosts = posts
  .map((post) => ({ ...post, _type: "article" as const }))
  .sort((a, b) => {
    const dateA = new Date(a.data.pubDate).getTime();
    const dateB = new Date(b.data.pubDate).getTime();
    return dateB - dateA;
  });
---

<BaseLayout title="Articles · Guilherme">
  <section class="index-page">
    <header class="index-page__header">
      <p class="index-page__path" aria-hidden="true">~/articles</p>
      <h1 class="page-title">Articles</h1>
      <p class="page-lead">Escritos técnicos mais longos.</p>
    </header>
    <PostList posts={sortedPosts} />
  </section>
</BaseLayout>

<style>
  .index-page__header {
    margin-bottom: 1.5rem;
  }

  .index-page__path {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--prompt-color);
  }
</style>
