---
import { getCollection } from "astro:content";
import GoBackButton from "../../../components/GoBackButton.astro";
import PostList from "../../../components/PostList.astro";
import { useTranslations } from "../../../i18n/utils";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const t = useTranslations("pt-br");
const posts = await getCollection("pt-br", (post) => !post.data.draft);

const sortedPosts = posts
  .map((post) => ({ ...post, _type: "article" as const }))
  .sort((a, b) => {
    const dateA = new Date(a.data.pubDate).getTime();
    const dateB = new Date(b.data.pubDate).getTime();
    return dateB - dateA;
  });

const count = sortedPosts.length;
---

<BaseLayout
  title={t("seo.articles.title")}
  description={t("seo.articles.description")}
>
  <section class="index-page">
    <GoBackButton />
    <header class="index-page__header">
      <p class="index-page__path" aria-hidden="true">~/articles</p>
      <h1 class="page-title">Artigos</h1>
      <p class="page-lead">
        Escritos técnicos mais longos — tutoriais, aprofundamentos e relatos de
        projetos. Anotações curtas ficam em
        <a href="/pt-br/notes">Anotações</a>.
      </p>
      <p class="index-page__meta mono" aria-hidden="true">
        {count} {count === 1 ? "entrada" : "entradas"}
      </p>
    </header>
    <PostList posts={sortedPosts} showType={false} showDescription={true} />
  </section>
</BaseLayout>

<style>
  .index-page__header {
    margin: 0.75rem 0 1.5rem;
  }

  .index-page__path {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--prompt-color);
  }

  .index-page__header :global(.page-lead) {
    margin-bottom: 0.75rem;
  }

  .index-page__meta {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
</style>
