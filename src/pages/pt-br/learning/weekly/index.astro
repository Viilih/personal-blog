---
import { getCollection } from "astro:content";
import GoBackButton from "components/GoBackButton.astro";
import BaseLayout from "layouts/BaseLayout.astro";
import PostList from "../../../../components/PostList.astro";

const posts = await getCollection("pt-br-weekly", (post) => !post.data.draft);

const sortedPosts = posts
  .sort((a, b) => {
    const dateA = new Date(a.data.pubDate).getTime();
    const dateB = new Date(b.data.pubDate).getTime();
    return dateB - dateA;
  })
  .map((post) => ({ ...post, _type: "weekly" as const }));
---

<BaseLayout title="Weekly · Guilherme">
  <GoBackButton />
  <header class="weekly-header">
    <p class="weekly-path" aria-hidden="true">~/learning/weekly</p>
    <h1 class="page-title">Semanal</h1>
    <p class="page-lead">Estudos, reflexões e ideias semanais.</p>
  </header>
  <PostList posts={sortedPosts} />
</BaseLayout>

<style>
  .weekly-header {
    margin: 0.75rem 0 1.5rem;
  }

  .weekly-path {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--prompt-color);
  }
</style>
