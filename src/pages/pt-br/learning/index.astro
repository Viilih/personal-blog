---
import GoBackButton from "components/GoBackButton.astro";
import BaseLayout from "layouts/BaseLayout.astro";
---

<BaseLayout title="Learning · Guilherme">
  <GoBackButton />
  <header class="learning-header">
    <p class="learning-path" aria-hidden="true">~/learning</p>
    <h1 class="page-title">Aprendizado</h1>
    <p class="page-lead">
      Projetos, anotações e ideias durante o estudo de um tópico.
    </p>
  </header>
  <p class="learning-link">
    <a href="/pt-br/learning/weekly">
      <span class="mono" aria-hidden="true">→</span>
      Estudos, reflexões e ideias semanais
    </a>
  </p>
</BaseLayout>

<style>
  .learning-header {
    margin: 0.75rem 0 1.5rem;
  }

  .learning-path {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--prompt-color);
  }

  .learning-link a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--heading-color);
    font-weight: 500;
    text-decoration: none;
  }

  .learning-link a:hover {
    color: var(--link-color);
    text-decoration: underline;
  }

  .learning-link .mono {
    color: var(--accent-color);
  }
</style>
