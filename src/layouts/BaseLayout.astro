---
import { ClientRouter } from "astro:transitions";
import Sidebar from "../components/Sidebar.astro";
import "../styles/global.css";
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const title = Astro.props.title || Astro.props.pageTitle || "Guilherme Nascimento";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <div class="shell">
      <aside class="shell__nav" aria-label="Site">
        <Sidebar />
      </aside>
      <main class="shell__main">
        <div class="shell__content">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
<script src="/theme-util.js" type="text/javascript" is:inline></script>

<style is:global>
  .shell {
    display: grid;
    grid-template-columns: var(--nav-width) minmax(0, 1fr);
    gap: 2.5rem;
    max-width: var(--shell-max);
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    min-height: 100vh;
  }

  .shell__nav {
    position: relative;
  }

  .shell__main {
    min-width: 0;
  }

  .shell__content {
    max-width: 100%;
  }

  .meta-info {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0.75rem 0 1.5rem;
  }

  @media (max-width: 860px) {
    .shell {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 1.25rem 1rem 3rem;
    }
  }
</style>
