---
import GoBackButton from "../components/GoBackButton.astro";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { getLangFromUrl } from "../i18n/utils";

interface Heading {
  depth: number;
  text: string;
  slug: string;
  subheadings: Heading[];
}
const { frontmatter, headings = [], minutesRead } = Astro.props;

const lang = getLangFromUrl(Astro.url);

const formatDate = (date: Date) => {
  const locale = lang === "pt-br" ? "pt-BR" : "en-US";
  return date.toLocaleDateString(locale, {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
};

const publishDate = new Date(frontmatter.pubDate);
const formattedDate = formatDate(publishDate);

function buildToc(headings: Heading[]) {
  if (!headings || !Array.isArray(headings)) {
    return [];
  }

  const toc: Heading[] = [];
  const parentHeadings = new Map();

  headings.forEach((h: any) => {
    const heading = { ...h, subheadings: [] };
    parentHeadings.set(heading.depth, heading);

    if (heading.depth === 2) {
      toc.push(heading);
    } else {
      const parentHeading = parentHeadings.get(heading.depth - 1);
      if (parentHeading) {
        parentHeading.subheadings.push(heading);
      } else {
        toc.push(heading);
      }
    }
  });

  return toc;
}

const toc = buildToc(headings);
---

<BaseLayout title={frontmatter.title}>
  <div class="doc">
    <article class="doc__article">
      <GoBackButton />
      <header class="doc__header">
        <h1 class="doc__title">{frontmatter.title}</h1>
        <div class="doc__meta">
          <time datetime={publishDate.toISOString()}>{formattedDate}</time>
          {minutesRead && <span aria-hidden="true">·</span>}
          {minutesRead && <span>{minutesRead}</span>}
        </div>
      </header>
      <div class="doc__body">
        <slot />
      </div>
    </article>
    <aside class="doc__toc">
      <TableOfContents toc={toc} />
    </aside>
  </div>
</BaseLayout>

<style>
  .doc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 200px;
    gap: 2.5rem;
    align-items: start;
  }

  .doc__article {
    max-width: var(--measure);
    min-width: 0;
  }

  .doc__header {
    margin: 1rem 0 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .doc__title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.65rem, 2.4vw, 2.1rem);
    line-height: 1.2;
  }

  .doc__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .doc__body {
    text-align: left;
  }

  .doc__body :global(h2),
  .doc__body :global(h3) {
    margin-top: 2rem;
    scroll-margin-top: 1.5rem;
  }

  .doc__toc {
    position: relative;
  }

  @media (max-width: 1024px) {
    .doc {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .doc__toc {
      order: -1;
    }
  }

  @media (max-width: 640px) {
    .doc__toc {
      display: none;
    }
  }
</style>
